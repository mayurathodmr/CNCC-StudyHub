["Which layer is responsible for routing?",["Physical","Data Link","Network","Application"],2],
["How many layers are in OSI model?",["4","5","7","8"],2],
["Which protocol is reliable and connection-oriented?",["UDP","TCP","IP","DNS"],1],
["DNS is mainly used for?",["Encryption","Name resolution","Routing","Framing"],1],
["IPv4 address length is?",["16 bit","32 bit","64 bit","128 bit"],1],
["IPv6 address length is?",["32 bit","64 bit","96 bit","128 bit"],3],
["Which is an example of IaaS?",["Virtual machine infrastructure","Email application","Web browser","Text editor"],0],
["Which cloud model provides ready-to-use software?",["IaaS","PaaS","SaaS","LAN"],2],
["Which device commonly forwards packets between networks?",["Switch","Router","Keyboard","Monitor"],1],
["Which layer uses MAC addressing?",["Application","Transport","Network","Data Link"],3],
["Which protocol commonly uses port 443?",["HTTP","HTTPS","FTP","DNS"],1],
["Which is a cloud deployment model?",["Hybrid","TCP","DNS","OSI"],0]
];

function $(id){return document.getElementById(id)}

function showPage(id){
 document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
 $(id).classList.add("active");

 document.querySelectorAll(".nav").forEach(n=>{
   n.classList.toggle("active",n.dataset.page===id || (id==="unitDetail"&&n.dataset.page==="units"));
 });

 window.scrollTo({top:0,behavior:"smooth"});
}

document.querySelectorAll(".nav").forEach(n=>{
 n.onclick=()=>showPage(n.dataset.page);
});

$("menuBtn").onclick=()=>{
 $("sidebar").classList.toggle("open");
};

$("themeBtn").onclick=()=>{
 document.body.classList.toggle("light");
 localStorage.setItem("theme",document.body.classList.contains("light")?"light":"dark");
 $("themeBtn").textContent=document.body.classList.contains("light")?"🌙":"☀️";
};

if(localStorage.getItem("theme")==="light"){
 document.body.classList.add("light");
 $("themeBtn").textContent="🌙";
}

function unitCard(key){
 const u=units[key];
 const num=key.replace("unit","");
 return `
 <div class="unit-card" onclick="openUnit('${key}')">
   <div class="unit-number">UNIT ${num} • ${u.hours}</div>
   <h3>${u.title}</h3>
   <p>${u.short}</p>
   <div class="progress"><span style="width:${Math.min(100,u.topics.length*11+25)}%"></span></div>
 </div>`;
}

$("homeUnits").innerHTML=Object.keys(units).slice(0,3).map(unitCard).join("");
$("allUnits").innerHTML=Object.keys(units).map(unitCard).join("");

$("syllabusContent").innerHTML=Object.entries(units).map(([key,u])=>{
 return `<div class="syllabus-card">
 <div class="unit-number">${key.toUpperCase()} • ${u.hours}</div>
 <h3>${u.title}</h3>
 <p>${u.short}</p>
 <p><b>Topics:</b> ${u.topics.map(x=>x.name).join(" • ")}</p>
 </div>`;
}).join("");

function openUnit(key){
 const u=units[key];
 $("unitDetailContent").innerHTML=`
 <div class="page-head">
   <span class="badge">${key.toUpperCase()} • ${u.hours}</span>
   <h2>${u.title}</h2>
   <p>${u.short}</p>
 </div>
 ${u.topics.map((t,i)=>`
 <article class="topic">
   <h3><span>${String(i+1).padStart(2,"0")}</span> ${t.name}</h3>
   <p>${t.explain}</p>
   <ul>${t.points.map(p=>`<li>${p}</li>`).join("")}</ul>
   <div class="exam-tip">🎯 <b>Exam Tip:</b> ${t.tip}</div>
 </article>`).join("")}
 `;
 showPage("unitDetail");
}

function renderQuestions(filter="all"){
 let list=questions.filter(x=>filter==="all"||String(x.m)===filter);
 $("questionList").innerHTML=list.map(x=>`
 <article class="question">
   <span class="marks">${x.m} MARKS • UNIT ${x.u}</span>
   <h3>${x.q}</h3>
   <div class="answer"><b>Answer:</b><p>${x.a}</p></div>
 </article>
 `).join("");
}

renderQuestions();

document.querySelectorAll(".filter").forEach(btn=>{
 btn.onclick=()=>{
   document.querySelectorAll(".filter").forEach(b=>b.classList.remove("active"));
   btn.classList.add("active");
   renderQuestions(btn.dataset.filter);
 };
});

