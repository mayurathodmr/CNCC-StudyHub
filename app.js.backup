const questions=[
{u:1,m:2,q:"What is a computer network?",a:"A computer network is an interconnected collection of devices that communicate and share data/resources using communication links and protocols."},
{u:1,m:2,q:"Define protocol.",a:"A protocol is a set of rules that defines how data is formatted, transmitted and interpreted between communicating devices."},
{u:1,m:5,q:"Explain different types of computer networks.",a:"PAN covers personal devices, LAN covers a small local area, MAN covers a city/metropolitan area and WAN covers a large geographical area. The Internet is a global interconnection of networks."},
{u:1,m:5,q:"Explain OSI model.",a:"OSI has seven layers: Physical, Data Link, Network, Transport, Session, Presentation and Application. Each layer performs a specific networking function."},
{u:1,m:10,q:"Explain OSI model with functions of all layers.",a:"Physical transmits bits; Data Link provides framing and MAC addressing; Network provides IP addressing and routing; Transport provides end-to-end delivery; Session manages sessions; Presentation handles translation, encryption and compression; Application provides network services to applications."},
{u:2,m:2,q:"What is framing?",a:"Framing is the process of dividing a continuous bit stream into identifiable data-link frames."},
{u:2,m:2,q:"What is an IP address?",a:"An IP address is a logical address used to identify a network interface and support packet delivery."},
{u:2,m:5,q:"Explain error control techniques.",a:"Error control uses techniques such as parity, checksum and CRC for error detection, and acknowledgements/retransmission for reliable delivery."},
{u:2,m:5,q:"Explain routing.",a:"Routing is the process of selecting a suitable path for packets from source to destination. Routing algorithms use metrics and network information to select paths."},
{u:2,m:10,q:"Explain Data Link Layer and its functions.",a:"Data Link Layer provides node-to-node delivery using framing, physical/MAC addressing, error detection, flow control and medium access control."},
{u:2,m:10,q:"Differentiate IP address and port address.",a:"IP address identifies a network interface/device at the network layer, while a port number identifies a specific application/service at the transport layer."},
{u:3,m:2,q:"What is DNS?",a:"DNS translates human-readable domain names into IP addresses and supports hierarchical name resolution."},
{u:3,m:5,q:"Differentiate TCP and UDP.",a:"TCP is connection-oriented, reliable and uses acknowledgements/retransmission. UDP is connectionless, has lower overhead and is useful where speed/latency is important."},
{u:3,m:5,q:"Explain WWW.",a:"WWW is a system of interconnected web resources accessed through browsers using technologies such as URLs, HTTP/HTTPS and web servers."},
{u:4,m:2,q:"Define cloud computing.",a:"Cloud computing provides computing resources such as servers, storage and applications over a network on demand."},
{u:4,m:5,q:"Explain virtualization.",a:"Virtualization creates virtual versions of computing resources. A hypervisor can create and manage virtual machines while isolating workloads and improving resource utilization."},
{u:4,m:10,q:"Explain virtualization types and advantages.",a:"Types include server, storage, network, desktop and application virtualization. Advantages include resource utilization, isolation, flexibility, server consolidation, scalability and easier management."},
{u:5,m:2,q:"What is IaaS?",a:"IaaS provides infrastructure resources such as virtual machines, storage and networking as a service."},
{u:5,m:5,q:"Explain IaaS, PaaS and SaaS.",a:"IaaS provides infrastructure, PaaS provides an application development/deployment platform, and SaaS provides ready-to-use software applications."},
{u:5,m:10,q:"Explain cloud deployment models.",a:"Public cloud resources are generally shared among customers, private cloud is dedicated to one organization, hybrid cloud combines cloud environments, and community cloud is designed for organizations sharing common requirements."},
{u:6,m:2,q:"What is cloud storage?",a:"Cloud storage stores data on provider-managed remote infrastructure and provides access through a network."},
{u:6,m:5,q:"Explain AWS.",a:"AWS is a cloud platform providing services across compute, storage, databases, networking, security and monitoring."},
{u:6,m:5,q:"Explain Google App Engine.",a:"Google App Engine is a managed application platform that lets developers deploy applications while the platform handles much of the underlying infrastructure."},
{u:6,m:5,q:"Explain Microsoft Azure.",a:"Microsoft Azure provides cloud services including virtual machines, storage, databases, networking and application services."}
];

