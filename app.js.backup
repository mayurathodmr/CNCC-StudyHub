 ["OSI 7 Layer Model",["Application","Presentation","Session","Transport","Network","Data Link","Physical"],"OSI Model networking layers"],
 ["Basic Network Communication",["Sender","Switch / Router","Network","Receiver"],"Computer network sender receiver diagram"],
 ["TCP/IP Model",["Application","Transport","Internet","Network Access"],"TCP IP model diagram"],
 ["Cloud Architecture",["User","Internet","Cloud Provider","Compute / Storage"],"cloud computing architecture diagram"],
 ["IaaS PaaS SaaS",["IaaS","PaaS","SaaS"],"IaaS PaaS SaaS service models diagram"],
 ["Public Private Hybrid",["Public Cloud","Private Cloud","Hybrid Cloud","Community Cloud"],"cloud deployment models diagram"]
];

$("diagramList").innerHTML=diagrams.map(d=>`
 <article class="diagram-card">
   <h3>${d[0]}</h3>
   <div class="diagram">
     <div class="diagram-row">
       ${d[1].map((x,i)=>`
       ${i?'<span class="arrow">→</span>':''}
       <div class="dbox">${x}</div>`).join("")}
     </div>
   </div>
   <div class="diagram-actions">
     <a target="_blank" href="https://www.google.com/search?tbm=isch&q=${encodeURIComponent(d[2])}">🔎 Google Images</a>
     <a target="_blank" href="https://www.google.com/search?q=${encodeURIComponent(d[2])}">🌐 Search Details</a>
   </div>
 </article>
`).join("");

let qi=0;
let score=0;
let answered=false;

function loadQuestion(){
 if(qi>=mcqs.length){
   $("qText").textContent="🎉 Test Completed!";
   $("options").innerHTML="";
   $("nextBtn").style.display="none";
   $("quizResult").innerHTML=`<div class="exam-note"><h3>Your Score: ${score}/${mcqs.length}</h3><p>Test पुन्हा करण्यासाठी page refresh करा.</p></div>`;
   return;
 }

 answered=false;
 const q=mcqs[qi];
 $("qNumber").textContent=`Question ${qi+1} / ${mcqs.length}`;
 $("score").textContent=`Score: ${score}`;
 $("qText").textContent=q[0];

 $("options").innerHTML=q[1].map((o,i)=>
 `<button class="option" onclick="answer(${i})">${String.fromCharCode(65+i)}. ${o}</button>`
 ).join("");
}

window.answer=function(i){
 if(answered)return;
 answered=true;

 const correct=mcqs[qi][2];
 document.querySelectorAll(".option").forEach((b,n)=>{
   if(n===correct)b.classList.add("correct");
   if(n===i&&i!==correct)b.classList.add("wrong");
 });

 if(i===correct){
   score++;
   showToast("Correct answer ✓");
 }else{
   showToast("Wrong answer — correct option highlighted");
 }

 $("score").textContent=`Score: ${score}`;
};

$("nextBtn").onclick=()=>{
 if(!answered){
   showToast("First select an answer");
   return;
 }
 qi++;
 loadQuestion();
};

loadQuestion();

function showToast(msg){
 $("toast").textContent=msg;
 $("toast").classList.add("show");
 setTimeout(()=>$("toast").classList.remove("show"),2200);
}

console.log("CNCC StudyHub loaded successfully.");
