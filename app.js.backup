const units = {

unit1:{
title:"Introduction to Computer Networks",
hours:"06 Hrs",
short:"Uses, types, technologies, protocols, OSI, TCP/IP and standardization.",
topics:[
{
name:"Uses of Computer Networks",
explain:"Computer network म्हणजे दोन किंवा अधिक computing devices यांना communication medium द्वारे जोडून data आणि resources share करण्याची व्यवस्था. Networks मुळे users files, printers, applications, internet आणि services share करू शकतात.",
points:[
"Resource sharing – printers, storage आणि software share करता येतात.",
"Communication – email, messaging, video conferencing शक्य होते.",
"Information sharing – files आणि databases access करता येतात.",
"Remote access – दुसऱ्या location वरून systems/services वापरता येतात.",
"Cost reduction – shared resources मुळे hardware cost कमी होतो."
],
tip:"Exam मध्ये definition + 4 uses + one real-life example लिहा."
},
{
name:"Types of Computer Networks",
explain:"Network चे classification सामान्यतः geographical coverage, architecture आणि communication technology यावर केले जाते.",
points:[
"PAN – Personal Area Network; अतिशय छोट्या area मध्ये.",
"LAN – Local Area Network; room, building किंवा campus सारख्या area मध्ये.",
"MAN – Metropolitan Area Network; city-level coverage.",
"WAN – Wide Area Network; large geographical area.",
"Internet – अनेक networks चे global interconnection."
],
tip:"PAN → LAN → MAN → WAN हा coverage क्रम लक्षात ठेवा."
},
{
name:"Network Technologies",
explain:"Network technology म्हणजे devices मध्ये communication करण्यासाठी वापरली जाणारी transmission आणि connectivity method.",
points:[
"Ethernet – wired LAN technology.",
"Wi-Fi – wireless LAN technology.",
"Fiber optics – high-speed long-distance communication.",
"Mobile networks – cellular communication.",
"Bluetooth – short-range wireless communication."
],
tip:"Wired vs Wireless comparison हा 5 marks साठी तयार ठेवा."
},
{
name:"Network Protocols",
explain:"Protocol म्हणजे communication करण्यासाठी devices ने follow करायचे rules. Sender आणि receiver मध्ये data कसा format, transmit आणि interpret करायचा हे protocol ठरवते.",
points:[
"HTTP/HTTPS – web communication.",
"FTP – file transfer.",
"DNS – domain name resolution.",
"TCP – reliable transport.",
"UDP – fast connectionless transport.",
"IP – logical addressing आणि packet delivery."
],
tip:"Protocol म्हणजे communication rules — ही definition नक्की लक्षात ठेवा."
},
{
name:"OSI Reference Model",
explain:"OSI model हा networking communication समजण्यासाठी सात-layer reference model आहे. प्रत्येक layer ला specific responsibility दिलेली असते.",
points:[
"7 Application – network services to applications.",
"6 Presentation – translation, encryption, compression.",
"5 Session – sessions establish/manage/terminate.",
"4 Transport – end-to-end delivery.",
"3 Network – routing and logical addressing.",
"2 Data Link – framing and MAC addressing.",
"1 Physical – bits and physical transmission."
],
tip:"Mnemonic: All People Seem To Need Data Processing."
},
{
name:"TCP/IP Model",
explain:"TCP/IP हा practical networking model आहे जो Internet communication मध्ये वापरला जातो.",
points:[
"Application layer – HTTP, DNS, SMTP इ.",
"Transport layer – TCP आणि UDP.",
"Internet layer – IP and routing.",
"Network Access layer – actual network transmission."
],
tip:"OSI आणि TCP/IP comparison 5/10 marks मध्ये विचारला जाऊ शकतो."
},
{
name:"Standardization, Policy, Legal and Social Issues",
explain:"Networking मध्ये standards मुळे different vendors ची systems एकमेकांशी communicate करू शकतात. Networking चा वापर करताना privacy, security, cyber law आणि ethical issues सुद्धा महत्त्वाचे आहेत.",
points:[
"Standards improve interoperability.",
"Security protects data and systems.",
"Privacy protects personal information.",
"Cyber laws control illegal digital activities.",
"Ethical use prevents misuse of technology."
],
tip:"Technical answer सोबत privacy/security examples दिल्यास answer strong होतो."
}
]
