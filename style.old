*{box-sizing:border-box;margin:0;padding:0}
:root{
--bg:#07070b;--panel:#101017;--panel2:#171720;--text:#f7f7fa;
--muted:#92929f;--line:#ffffff12;--white:#fff;--black:#08080a
}
body.light{
--bg:#f5f5f7;--panel:#fff;--panel2:#ededf1;--text:#111118;
--muted:#6b6b75;--line:#00000012;--white:#111118;--black:#fff
}
body{
background:var(--bg);color:var(--text);font-family:Inter,system-ui,sans-serif;
transition:.35s;min-height:100vh
}
button,input,textarea{font:inherit}
button{cursor:pointer}
#splash{
position:fixed;inset:0;z-index:9999;background:#07070b;color:#fff;
display:grid;place-content:center;text-align:center;gap:12px;
animation:splashOut .8s 1.7s forwards
}
.splash-logo,.logo{
display:grid;place-items:center;background:#fff;color:#07070b;
font-weight:1000;border-radius:18px
}
.splash-logo{width:85px;height:85px;margin:auto;font-size:25px}
.loader{width:190px;height:3px;background:#222;margin:auto;overflow:hidden}
.loader span{display:block;width:0;height:100%;background:#fff;animation:load 1.5s forwards}
@keyframes load{to{width:100%}}
@keyframes splashOut{to{opacity:0;visibility:hidden;pointer-events:none}}
.topbar{
height:74px;position:sticky;top:0;z-index:100;display:flex;align-items:center;
gap:25px;padding:0 4%;background:#07070ddd;backdrop-filter:blur(25px);
border-bottom:1px solid var(--line)
}
.light .topbar{background:#f5f5f7dd}
.brand{display:flex;align-items:center;gap:11px;min-width:225px}
.logo{width:44px;height:44px;font-size:12px}
.brand b{display:block}.brand small{display:block;color:var(--muted);font-size:9px}
.search{
display:flex;align-items:center;gap:10px;max-width:600px;flex:1;
padding:12px 15px;border:1px solid var(--line);background:var(--panel);
border-radius:14px
}
.search input{width:100%;border:0;outline:0;background:none;color:var(--text)}
.actions{display:flex;gap:8px}.actions button{
width:40px;height:40px;border:1px solid var(--line);background:var(--panel);
color:var(--text);border-radius:11px
}
.layout{display:flex;max-width:1600px;margin:auto}
.sidebar{
width:220px;position:sticky;top:74px;height:calc(100vh - 74px);
padding:28px 14px;border-right:1px solid var(--line);
display:flex;flex-direction:column
}
.menu-title{font-size:9px;letter-spacing:2px;color:var(--muted);padding:0 12px 14px}
.nav{
border:0;background:none;color:var(--muted);padding:12px 14px;border-radius:12px;
display:flex;align-items:center;gap:13px;text-align:left;margin:2px 0
}
.nav:hover,.nav.active{background:var(--panel2);color:var(--text)}
.side-bottom{margin-top:auto}
.eco-card{
background:var(--panel);border:1px solid var(--line);border-radius:14px;
padding:14px;margin-bottom:10px;font-size:12px
}
.eco-card small{display:block;color:var(--muted);font-size:9px;margin-top:4px}
main{width:calc(100% - 220px)}
.hero{
min-height:610px;display:flex;align-items:center;position:relative;overflow:hidden;
padding:80px 7%;background:radial-gradient(circle at 78% 45%,#fff1,transparent 30%)
}
.hero-copy{max-width:690px;z-index:2}.hero-copy>small,.section small{
color:var(--muted);font-size:9px;letter-spacing:2px;font-weight:900
}
.hero h1{font-size:clamp(48px,6vw,82px);line-height:.94;margin:20px 0}
.hero h1 em{
font-style:normal;background:linear-gradient(90deg,#fff,#777);
-webkit-background-clip:text;color:transparent
}
.hero p{color:var(--muted);line-height:1.7;max-width:590px}
.hero-buttons{display:flex;gap:10px;margin-top:28px}
.primary,.secondary{
padding:13px 19px;border-radius:12px;font-weight:900;border:0
}
.primary{background:var(--white);color:var(--black)}
.secondary{background:var(--panel);color:var(--text);border:1px solid var(--line)}
.stats{display:flex;gap:35px;margin-top:45px}
.stats b{display:block;font-size:24px}.stats span{font-size:9px;color:var(--muted)}
.hero-visual{position:absolute;right:6%;width:390px;height:390px;display:grid;place-items:center}
.orb{position:absolute;inset:15%;border-radius:50%;background:radial-gradient(circle,#fff2,transparent 65%);filter:blur(12px)}
.hero-logo{
width:150px;height:150px;border-radius:50%;display:grid;place-items:center;
font-size:30px;font-weight:1000;background:#ffffff08;border:1px solid #fff2;
box-shadow:0 0 100px #fff2;z-index:2
}
.floating{
position:absolute;padding:15px 19px;border-radius:14px;
background:#ffffff0b;border:1px solid var(--line);backdrop-filter:blur(20px);
display:flex;gap:8px;animation:float 4s infinite ease-in-out
}
.f1{top:40px;left:0}.f2{right:0;top:145px;animation-delay:.8s}
.f3{bottom:35px;left:50px;animation-delay:1.4s}
@keyframes float{50%{transform:translateY(-13px)}}
.section{padding:42px 5%}.section-head{
display:flex;justify-content:space-between;align-items:end;margin-bottom:20px
}
.section-head h2{margin-top:5px;font-size:27px}.text-btn{
background:none;border:0;color:var(--muted)
}
.unit-scroll{display:flex;gap:13px;overflow-x:auto;padding-bottom:10px}
.unit{
min-width:250px;height:155px;padding:20px;border-radius:17px;
border:1px solid var(--line);background:linear-gradient(145deg,var(--panel2),var(--panel));
transition:.3s;position:relative;overflow:hidden
}
.unit:hover,.feature-grid button:hover,.subject:hover,.question:hover{
transform:translateY(-5px);border-color:#fff3
}
.unit h3{margin:12px 0 6px}.unit p{font-size:10px;color:var(--muted)}
.unit .bar{position:absolute;left:0;bottom:0;height:3px;background:var(--white)}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px}
.feature-grid button{
text-align:left;background:var(--panel);color:var(--text);
border:1px solid var(--line);border-radius:17px;padding:22px;transition:.3s
}
.feature-grid strong{display:block;font-size:16px}.feature-grid span{
display:block;color:var(--muted);font-size:10px;margin-top:10px;line-height:1.5
}
.subject-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:13px}
.subject{
min-height:195px;padding:22px;border:1px solid var(--line);
background:linear-gradient(145deg,var(--panel2),var(--panel));
border-radius:18px;transition:.3s;position:relative
}
.subject-icon{font-size:38px}.subject h3{margin-top:15px}
.subject p{font-size:10px;color:var(--muted);margin-top:5px}
.subject .prof{position:absolute;bottom:19px;font-size:9px;color:var(--muted)}
.question-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
.question{
background:var(--panel);border:1px solid var(--line);border-radius:16px;
padding:19px;transition:.3s
}
.question .mark{font-size:9px;color:var(--muted);letter-spacing:1px}
.question p{font-size:13px;line-height:1.55;margin-top:10px}
.resource-banner{
padding:32px;border:1px solid var(--line);border-radius:20px;
background:linear-gradient(120deg,var(--panel2),var(--panel));
display:flex;align-items:center;justify-content:space-between;gap:20px
}
.resource-banner h2{margin:8px 0}.resource-banner p{color:var(--muted);font-size:11px}
.people{display:grid;grid-template-columns:1fr 1fr;gap:13px}
.teacher-card,.creator-card{
padding:28px;border:1px solid var(--line);border-radius:20px;background:var(--panel)
}
.teacher-card{display:flex;gap:18px;align-items:center}.teacher-avatar{font-size:48px}
.teacher-card p,.creator-card p{color:var(--muted);font-size:11px;margin-top:6px}
.links{display:flex;gap:8px;flex-wrap:wrap;margin-top:18px}
.links a{
text-decoration:none;color:var(--text);border:1px solid var(--line);
border-radius:9px;padding:8px 11px;font-size:10px
}
.feedback{text-align:center;max-width:760px;margin:auto}
.feedback h2{margin:7px 0 12px}.feedback textarea{
width:100%;height:110px;margin:10px 0 15px;border-radius:14px;
padding:14px;background:var(--panel);color:var(--text);
border:1px solid var(--line);outline:none;resize:none
}
#stars button{border:0;background:none;color:#666;font-size:31px}
#stars button.active{color:#ffd45c}
#feedbackMsg{color:var(--muted);font-size:11px;margin-top:10px}
.modal{
display:none;position:fixed;inset:0;z-index:500;background:#000b;
backdrop-filter:blur(12px);align-items:center;justify-content:center;padding:16px
}
.modal.show{display:flex}.modal-box{
width:min(900px,100%);max-height:88vh;overflow:auto;
background:var(--panel);border:1px solid var(--line);border-radius:22px;
padding:30px;position:relative
}
.close{
position:absolute;right:15px;top:14px;width:36px;height:36px;border:0;
border-radius:10px;background:var(--panel2);color:var(--text);font-size:22px
}
.modal-box h2{margin:8px 0 15px}.modal-box p{color:var(--muted);line-height:1.7}
.modal-question{
padding:17px 0;border-bottom:1px solid var(--line)
}
.modal-question p{margin:7px 0}.modal-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}
.resource-box{
padding:20px;border:1px solid var(--line);background:var(--panel2);
border-radius:16px;margin:12px 0
}
.resource-box a{display:inline-block;margin:7px 7px 0 0;color:var(--text)}
.diagram{
width:100%;min-height:170px;display:grid;place-items:center;
background:var(--panel2);border:1px dashed var(--line);
border-radius:15px;margin-top:12px;font-size:42px
}
.profile-form{display:grid;gap:10px}.profile-form input{
background:var(--panel2);border:1px solid var(--line);padding:13px;
border-radius:11px;color:var(--text);outline:0
}
.mobile-nav{display:none}
footer{text-align:center;padding:45px;color:var(--muted);border-top:1px solid var(--line)}
footer b{color:var(--text)}
@media(max-width:1000px){
.hero-visual{opacity:.3}.feature-grid{grid-template-columns:1fr 1fr}
.question-grid{grid-template-columns:1fr 1fr}.people{grid-template-columns:1fr}
}
@media(max-width:700px){
.topbar{height:64px;padding:0 13px}.brand{min-width:auto}.brand small{display:none}
.search{display:none}.actions{margin-left:auto}.sidebar{display:none}
main{width:100%}.hero{min-height:650px;padding:45px 20px;align-items:flex-end}
.hero h1{font-size:51px}.hero-visual{right:-120px;top:10px}.hero-copy{margin-top:120px}
.stats{gap:20px;flex-wrap:wrap}.section{padding:30px 15px}
.feature-grid,.question-grid{grid-template-columns:1fr}.resource-banner{display:block}
.resource-banner button{margin-top:18px}.mobile-nav{
position:fixed;display:flex;z-index:300;bottom:0;left:0;right:0;height:65px;
background:#09090eee;backdrop-filter:blur(20px);border-top:1px solid var(--line);
justify-content:space-around
}
.mobile-nav button{border:0;background:none;color:#aaa;font-size:18px}
.mobile-nav small{display:block;font-size:8px;margin-top:3px}
footer{padding-bottom:95px}
}


/* DEEP NOTES UPGRADE */
.study-topic{
margin-top:18px;
scroll-margin-top:90px
}
.study-topic h2{
font-size:25px;
margin:8px 0 20px
}
.study-topic h3{
margin:22px 0 8px;
font-size:14px
}
.study-topic p{
white-space:pre-line
}
.study-topic ul{
padding-left:22px;
color:var(--muted);
line-height:1.9;
font-size:12px
}
.topic-index{
padding:20px;
border:1px solid var(--line);
border-radius:16px;
background:var(--panel2);
line-height:2;
color:var(--muted)
}
.topic-index b{color:var(--text)}
.eco{
filter:saturate(.8)
}
@media(max-width:700px){
.study-topic h2{font-size:21px}
.modal-box{padding:20px}
.diagram{font-size:25px;min-height:140px}
}

/* =========================================================
   CSD STUDYHUB — PREMIUM TEACHER / STUDENT PANEL
========================================================= */

.role-panel{
position:fixed;
inset:0;
z-index:99999;
display:flex;
align-items:center;
justify-content:center;
padding:20px;
background:rgba(3,5,10,.88);
backdrop-filter:blur(25px);
-webkit-backdrop-filter:blur(25px);
animation:panelFade .5s ease;
}

.role-card{
width:min(900px,100%);
padding:38px;
border:1px solid rgba(255,255,255,.14);
border-radius:30px;
background:linear-gradient(145deg,rgba(25,28,38,.98),rgba(8,10,16,.98));
box-shadow:0 30px 100px rgba(0,0,0,.7);
text-align:center;
}

.role-logo{
width:76px;
height:76px;
margin:auto;
display:grid;
place-items:center;
border-radius:24px;
font-size:36px;
background:linear-gradient(135deg,#fff,#777);
color:#000;
box-shadow:0 12px 40px rgba(255,255,255,.16);
}

.role-card h1{
font-size:clamp(28px,5vw,52px);
margin:22px 0 8px;
letter-spacing:-2px;
}

.role-card>p{
color:#9299a8;
margin-bottom:30px;
}

.role-grid{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:18px;
}

.role-choice{
text-align:left;
padding:26px;
border:1px solid rgba(255,255,255,.10);
border-radius:22px;
background:rgba(255,255,255,.035);
cursor:pointer;
transition:.3s ease;
}

.role-choice:hover{
transform:translateY(-7px);
border-color:rgba(255,255,255,.35);
box-shadow:0 20px 50px rgba(0,0,0,.35);
}

.role-choice .big{
font-size:42px;
}

.role-choice h3{
margin:12px 0 7px;
font-size:21px;
}

.role-choice p{
font-size:12px;
color:#858c9b;
line-height:1.6;
}

.dashboard-panel{
position:fixed;
inset:0;
z-index:99998;
overflow:auto;
display:none;
background:#07090e;
color:#fff;
}

.dashboard-panel.show{
display:block;
animation:panelFade .35s ease;
}

.dashboard-top{
position:sticky;
top:0;
z-index:10;
display:flex;
align-items:center;
justify-content:space-between;
gap:15px;
padding:18px 25px;
background:rgba(7,9,14,.82);
border-bottom:1px solid rgba(255,255,255,.08);
backdrop-filter:blur(20px);
}

.dashboard-brand{
display:flex;
align-items:center;
gap:12px;
font-weight:800;
}

.dashboard-brand-icon{
width:42px;
height:42px;
display:grid;
place-items:center;
border-radius:13px;
background:#fff;
color:#000;
}

.close-dashboard{
border:1px solid rgba(255,255,255,.12);
background:rgba(255,255,255,.06);
color:#fff;
padding:10px 15px;
border-radius:12px;
cursor:pointer;
}

.dashboard-wrap{
width:min(1200px,94%);
margin:auto;
padding:35px 0 70px;
}

.dashboard-hero{
padding:35px;
border-radius:28px;
background:
radial-gradient(circle at 85% 15%,rgba(255,255,255,.12),transparent 30%),
linear-gradient(135deg,#171b25,#0a0c12);
border:1px solid rgba(255,255,255,.08);
margin-bottom:25px;
}

.dashboard-hero small{
color:#8e96a6;
letter-spacing:2px;
}

.dashboard-hero h1{
font-size:clamp(28px,5vw,48px);
margin:12px 0;
letter-spacing:-1.5px;
}

.dashboard-hero p{
color:#969ead;
}

.dashboard-stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:14px;
margin:25px 0;
}

.d-stat{
padding:22px;
border:1px solid rgba(255,255,255,.08);
background:rgba(255,255,255,.035);
border-radius:20px;
}

.d-stat b{
display:block;
font-size:28px;
margin-bottom:5px;
}

.d-stat span{
font-size:11px;
color:#858c9b;
}

.dashboard-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:16px;
}

.d-card{
padding:24px;
border-radius:22px;
border:1px solid rgba(255,255,255,.08);
background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.018));
transition:.25s;
}

.d-card:hover{
transform:translateY(-5px);
border-color:rgba(255,255,255,.2);
}

.d-card .d-icon{
font-size:30px;
margin-bottom:15px;
}

.d-card h3{
margin-bottom:8px;
}

.d-card p{
color:#858c9b;
font-size:12px;
line-height:1.6;
}

.d-action{
margin-top:15px;
border:0;
padding:11px 15px;
border-radius:12px;
background:#fff;
color:#000;
font-weight:700;
cursor:pointer;
}

.teacher-subject{
margin-top:25px;
padding:25px;
border-radius:22px;
border:1px solid rgba(255,255,255,.08);
background:#0e1118;
}

.teacher-subject-head{
display:flex;
justify-content:space-between;
gap:15px;
align-items:center;
margin-bottom:20px;
}

.teacher-subject-head span{
padding:7px 10px;
border-radius:20px;
font-size:10px;
background:rgba(255,255,255,.08);
color:#aaa;
}

.student-list{
display:grid;
gap:10px;
}

.student-row{
display:flex;
justify-content:space-between;
align-items:center;
padding:14px;
border-radius:14px;
background:rgba(255,255,255,.035);
}

.student-row small{
color:#8c93a0;
}

.progress-mini{
width:100px;
height:5px;
background:#242833;
border-radius:20px;
overflow:hidden;
}

.progress-mini span{
display:block;
height:100%;
background:#fff;
}

@keyframes panelFade{
from{opacity:0;transform:scale(.98)}
to{opacity:1;transform:scale(1)}
}

@media(max-width:750px){
.role-grid{grid-template-columns:1fr}
.role-card{padding:25px}
.dashboard-stats{grid-template-columns:repeat(2,1fr)}
.dashboard-grid{grid-template-columns:1fr}
.dashboard-hero{padding:25px}
}
