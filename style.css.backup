*{
  box-sizing:border-box;
  margin:0;
  padding:0
}

:root{
  --bg:#080b14;
  --panel:#101522;
  --panel2:#151b2b;
  --text:#f4f7ff;
  --muted:#9da7bb;
  --line:#273044;
  --accent:#7c5cff;
  --accent2:#00d4ff;
  --good:#35d07f;
  --shadow:0 20px 60px rgba(0,0,0,.28)
}

body.light{
  --bg:#f4f7fb;
  --panel:#ffffff;
  --panel2:#eef2f8;
  --text:#111827;
  --muted:#5f6b7a;
  --line:#dce2ec;
  --shadow:0 15px 45px rgba(31,41,55,.12)
}

body{
  background:
  radial-gradient(circle at 80% 10%,rgba(124,92,255,.13),transparent 30%),
  var(--bg);
  color:var(--text);
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  min-height:100vh;
  transition:.3s
}

button{
  font:inherit;
  cursor:pointer
}

.topbar{
  height:72px;
  position:sticky;
  top:0;
  z-index:50;
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:0 28px;
  background:rgba(8,11,20,.82);
  backdrop-filter:blur(18px);
  border-bottom:1px solid var(--line)
}

body.light .topbar{
  background:rgba(255,255,255,.85)
}

.brand{
  display:flex;
  align-items:center;
  gap:12px
}

.logo,.big-logo{
  display:grid;
  place-items:center;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:white;
  font-weight:900;
  border-radius:15px;
  box-shadow:0 10px 30px rgba(124,92,255,.3)
}

.logo{
  width:44px;
  height:44px
}

.brand h1{
  font-size:18px
}

.brand h1 span{
  color:var(--accent2)
}

.brand small{
  color:var(--muted)
}

.top-actions{
  display:flex;
  gap:8px
}

.icon-btn{
  width:42px;
  height:42px;
  border:1px solid var(--line);
  border-radius:12px;
  background:var(--panel);
  color:var(--text)
}

.layout{
  display:flex;
  min-height:calc(100vh - 72px)
}

#sidebar{
  width:260px;
  position:sticky;
  top:72px;
  height:calc(100vh - 72px);
  padding:22px;
  border-right:1px solid var(--line);
  background:rgba(10,14,25,.72);
  backdrop-filter:blur(15px)
}

body.light #sidebar{
  background:rgba(255,255,255,.8)
}

.profile-card{
  padding:18px;
  border:1px solid var(--line);
  border-radius:18px;
  background:var(--panel);
  margin-bottom:20px;
  text-align:center
}

.avatar{
  width:54px;
  height:54px;
  margin:auto auto 9px;
  display:grid;
  place-items:center;
  border-radius:50%;
  background:linear-gradient(135deg,var(--accent),var(--accent2));
  color:white;
  font-weight:900
}

.profile-card span,
.teacher span{
  display:block;
  color:var(--muted);
  font-size:12px;
  margin-top:4px
}

nav{
  display:grid;
  gap:7px
}

.nav{
  border:0;
  background:transparent;
  color:var(--muted);
  text-align:left;
  padding:12px 13px;
  border-radius:12px;
  transition:.2s
}

.nav:hover,.nav.active{
  background:var(--panel2);
  color:var(--text)
}

.nav.active{
  box-shadow:inset 3px 0 var(--accent)
}

.teacher{
  position:absolute;
  bottom:22px;
  left:22px;
  right:22px;
  padding:14px;
  border:1px solid var(--line);
  border-radius:15px;
  background:var(--panel)
}

.teacher small{
  color:var(--accent2);
  font-size:9px;
  letter-spacing:1px
}

.teacher b{
  display:block;
  margin-top:5px;
  font-size:13px
}

main{
  width:100%;
  max-width:1400px;
  padding:32px;
  margin:auto
}

.page{
  display:none;
  animation:fade .35s ease
}

.page.active{
  display:block
}

@keyframes fade{
  from{opacity:0;transform:translateY(8px)}
  to{opacity:1;transform:none}
}

.hero{
  min-height:390px;
  display:grid;
  grid-template-columns:1.1fr .9fr;
  align-items:center;
  padding:42px;
  border:1px solid var(--line);
  border-radius:28px;
  background:
  linear-gradient(135deg,rgba(124,92,255,.14),transparent),
  var(--panel);
  box-shadow:var(--shadow);
  overflow:hidden
}

.badge{
  display:inline-block;
  padding:7px 11px;
  border:1px solid rgba(124,92,255,.4);
  border-radius:100px;
  color:var(--accent2);
  font-size:10px;
  font-weight:800;
  letter-spacing:1px
}

.hero h2{
  font-size:clamp(34px,5vw,64px);
  line-height:1.02;
  margin:18px 0
}

.hero h2 span{
  color:var(--accent2)
}

.hero p{
  color:var(--muted);
  max-width:600px;
  line-height:1.7
}

.hero-buttons{
  display:flex;
  gap:10px;
  margin-top:24px;
  flex-wrap:wrap
}

.primary,.secondary,.back{
  padding:12px 18px;
  border-radius:12px;
  border:1px solid var(--line)
}

.primary{
  color:white;
  border:0;
  background:linear-gradient(135deg,var(--accent),#5c43e8);
  box-shadow:0 10px 25px rgba(124,92,255,.25)
}

.secondary,.back{
  color:var(--text);
  background:var(--panel2)
}

.hero-network{
  height:280px;
  position:relative;
  display:grid;
  place-items:center
}

.node{
  position:absolute;
  padding:14px 18px;
  border-radius:15px;
  background:var(--panel2);
  border:1px solid var(--accent);
  font-size:12px;
  font-weight:800;
  z-index:2;
  box-shadow:0 0 30px rgba(124,92,255,.15)
}

.n1{left:4%;top:40%}
.n2{left:31%;top:15%}
.n3{right:27%;top:58%}
.n4{right:2%;top:22%}

.line{
  position:absolute;
  height:2px;
  background:linear-gradient(90deg,var(--accent),var(--accent2));
  transform-origin:left
}

.l1{width:115px;left:19%;top:46%;transform:rotate(-30deg)}
.l2{width:120px;left:44%;top:38%;transform:rotate(45deg)}
.l3{width:110px;left:64%;top:55%;transform:rotate(-25deg)}

.stats{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:14px;
  margin:18px 0 35px
}

.stat{
  padding:20px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:17px
}

.stat b{
  display:block;
  font-size:28px
}

.stat span{
  color:var(--muted);
  font-size:13px
}

.section-title,.page-head{
  margin-bottom:20px
}

.section-title small{
  color:var(--accent2)
}

.section-title h3,.page-head h2{
  font-size:28px;
  margin-top:5px
}

.page-head p{
  color:var(--muted);
  margin-top:7px
}

.unit-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:16px
}

.unit-card{
  padding:23px;
  border:1px solid var(--line);
  border-radius:20px;
  background:var(--panel);
  transition:.25s;
  cursor:pointer
}

.unit-card:hover{
  transform:translateY(-5px);
  border-color:var(--accent);
  box-shadow:var(--shadow)
}

.unit-number{
  color:var(--accent2);
  font-weight:900;
  font-size:12px
}

.unit-card h3{
  margin:9px 0
}

.unit-card p{
  color:var(--muted);
  line-height:1.55;
  font-size:13px
}

.progress{
  height:6px;
  background:var(--panel2);
  border-radius:10px;
  overflow:hidden;
  margin-top:15px
}

.progress span{
  display:block;
  height:100%;
  background:linear-gradient(90deg,var(--accent),var(--accent2))
}

.syllabus-card,.topic,.question,.diagram-card,.exam-note,.about-card{
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:19px;
  padding:22px;
  margin-bottom:15px
}

.syllabus-card h3{
  margin-bottom:10px
}

.syllabus-card p,.topic p,.question p,.exam-note li{
  color:var(--muted);
  line-height:1.7
}

.topic h3{
  color:var(--text);
  margin-bottom:8px
}

.topic h3 span{
  color:var(--accent2)
}

.topic ul{
  margin:10px 0 0 20px;
  color:var(--muted);
  line-height:1.8
}

.topic .exam-tip{
  margin-top:14px;
  padding:12px;
  border-left:3px solid var(--accent);
  background:var(--panel2);
  color:var(--text);
  border-radius:8px
}

.marks{
  display:inline-block;
  padding:5px 9px;
  border-radius:8px;
  background:var(--panel2);
  color:var(--accent2);
  font-size:11px;
  font-weight:800;
  margin-bottom:9px
}

.question h3{
  margin-bottom:9px
}

.answer{
  padding:14px;
  border-radius:12px;
  background:var(--panel2);
  margin-top:10px
}

.filters{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  margin-bottom:16px
}

.filter{
  padding:9px 15px;
  border:1px solid var(--line);
  border-radius:10px;
  background:var(--panel);
  color:var(--muted)
}

.filter.active{
  background:var(--accent);
  color:white
}

.quiz-card{
  max-width:800px;
  margin:auto;
  padding:28px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:22px;
  box-shadow:var(--shadow)
}

.quiz-top{
  display:flex;
  justify-content:space-between;
  color:var(--muted);
  font-size:13px
}

.quiz-card h3{
  margin:25px 0
}

.option{
  width:100%;
  text-align:left;
  padding:14px;
  margin:7px 0;
  border-radius:12px;
  border:1px solid var(--line);
  background:var(--panel2);
  color:var(--text)
}

.option:hover{
  border-color:var(--accent)
}

.option.correct{
  border-color:var(--good);
  background:rgba(53,208,127,.12)
}

.option.wrong{
  border-color:#ff5577;
  background:rgba(255,85,119,.1)
}

.next-btn{
  margin-top:18px
}

.diagram-card h3{
  margin-bottom:12px
}

.diagram{
  min-height:190px;
  padding:20px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:var(--panel2);
  border-radius:15px;
  overflow:auto
}

.diagram-row{
  display:flex;
  align-items:center;
  gap:10px;
  flex-wrap:wrap;
  justify-content:center
}

.dbox{
  padding:14px;
  min-width:100px;
  text-align:center;
  border:1px solid var(--accent);
  border-radius:10px;
  background:var(--panel);
  font-size:11px;
  font-weight:800
}

.arrow{
  color:var(--accent2);
  font-size:22px
}

.diagram-actions{
  display:flex;
  gap:8px;
  margin-top:12px;
  flex-wrap:wrap
}

.diagram-actions a{
  text-decoration:none;
  color:var(--text);
  background:var(--panel2);
  border:1px solid var(--line);
  padding:9px 12px;
  border-radius:9px;
  font-size:12px
}

.strategy-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:15px
}

.strategy-grid article{
  padding:23px;
  background:var(--panel);
  border:1px solid var(--line);
  border-radius:18px
}

.strategy-icon{
  font-weight:900;
  color:var(--accent2);
  margin-bottom:14px
}

.strategy-grid p{
  color:var(--muted);
  line-height:1.7
}

.exam-note{
  margin-top:18px
}

.exam-note li{
  margin-left:20px
}

.big-logo{
  width:80px;
  height:80px;
  font-size:25px;
  margin-bottom:20px
}

.about-card{
  max-width:850px;
  margin:auto
}

.about-card>p{
  color:var(--muted);
  line-height:1.7
}

.credits{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:12px;
  margin:25px 0
}

.credits div{
  padding:15px;
  border-radius:12px;
  background:var(--panel2)
}

.credits small{
  display:block;
  color:var(--accent2);
  font-size:9px;
  margin-bottom:5px
}

.copyright{
  border-top:1px solid var(--line);
  padding-top:18px
}

.copyright p{
  color:var(--muted);
  margin-top:6px;
  line-height:1.6
}

#toast{
  position:fixed;
  right:20px;
  bottom:20px;
  padding:12px 17px;
  border-radius:12px;
  background:var(--panel);
  border:1px solid var(--line);
  box-shadow:var(--shadow);
  transform:translateY(100px);
  transition:.3s;
  z-index:100
}

#toast.show{
  transform:none
}

@media(max-width:950px){
  #sidebar{
    position:fixed;
    left:-280px;
    z-index:100;
    transition:.3s
  }

  #sidebar.open{
    left:0
  }

  .hero{
    grid-template-columns:1fr
  }

  .unit-grid{
    grid-template-columns:repeat(2,1fr)
  }

  .strategy-grid{
    grid-template-columns:1fr
  }
}

@media(max-width:600px){
  .topbar{
    padding:0 14px
  }

  main{
    padding:18px 12px
  }

  .hero{
    padding:25px 18px;
    border-radius:20px
  }

  .hero h2{
    font-size:38px
  }

  .hero-network{
    height:210px;
    transform:scale(.82)
  }

  .stats{
    grid-template-columns:repeat(2,1fr)
  }

  .unit-grid{
    grid-template-columns:1fr
  }

  .credits{
    grid-template-columns:1fr
  }

  .quiz-card{
    padding:20px
  }
}
