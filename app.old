function studentSubjectArea(){

return `
<div class="student-list">

${DATA.units.map((u,i)=>{

const p=Number(localStorage.getItem("unitProgress"+i)||0);

return `
<div class="student-row">
<div>
<b>📘 ${u.title}</b><br>
<small>${u.subtitle}</small>
</div>
<div style="text-align:right">
<div class="progress-mini"><span style="width:${p}%"></span></div>
<small>${p}%</small>
</div>
</div>`;

}).join("")}

</div>`;
}

function closeDashboard(){

const d=document.getElementById("dashboardPanel");

if(d)d.remove();

if(!document.getElementById("rolePanel")){
createRoleSystem();
}
}

window.addEventListener("load",()=>{
setTimeout(createRoleSystem,1200);
});

